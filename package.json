{
  "name": "apple-notes-cli",
  "version": "0.1.0",
  "description": "CLI for managing Apple Notes via JXA",
  "type": "module",
  "bin": {
    "notes": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/__tests__/jxa.test.ts' 'src/__tests__/format.test.ts' 'src/__tests__/errors.test.ts'",
    "test:integration": "node --import tsx --test 'src/__tests__/integration.test.ts'"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
